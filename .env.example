# ==============================================================================
# YottaPerf Environment Configuration
# ==============================================================================
# ⚠️ CAUTION — DEMO / LOCAL EVALUATION SETTINGS ONLY:
# The default passwords, usernames, and secret keys defined below are provisioned
# solely for offline evaluator testing and local development.
#
# 🔒 PRODUCTION DEPLOYMENT SECURITY REQUIREMENTS:
# 1. POSTGRES_PASSWORD: Must be changed to a cryptographically strong, unique password.
# 2. SECRET_KEY: Must be set to a secure, random 64-character secret. The backend
#    will automatically abort startup if the default secret key is detected when
#    ENVIRONMENT=production.
# 3. ENVIRONMENT: Must be set to "production".
# 4. Store all production credentials in a zero-trust secret vault (e.g. AWS Secrets
#    Manager, HashiCorp Vault, or encrypted container secrets).
# ==============================================================================

# Application Environment (development | test | production)
ENVIRONMENT="development"
PROJECT_NAME="YottaPerf Performance Management Platform"
API_V1_STR="/api"

# JWT Security Settings
# DEMO-ONLY: Replace with `openssl rand -hex 32` for production
SECRET_KEY="yottaperf-super-secure-jwt-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (Local Docker Compose Defaults)
# DEMO-ONLY: Default evaluation credentials for yottaperf-db container
POSTGRES_USER=yotta_user
POSTGRES_PASSWORD=yotta_password
POSTGRES_DB=yottaperf_db
POSTGRES_PORT=5434

# Host connection string (Port 5434 mapped to Docker container port 5432)
DATABASE_URL="postgresql://yotta_user:yotta_password@localhost:5434/yottaperf_db"

# Deterministic Generator Settings (Audited Evaluation Seed)
DEFAULT_SEED=20261022
REFERENCE_DATE=2026-06-30

# Frontend Settings
NEXT_PUBLIC_API_URL="http://localhost:8001/api"

