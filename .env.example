# YottaPerf Environment Configuration

# Backend Settings
PROJECT_NAME="YottaPerf Performance Management Platform"
API_V1_STR="/api"
SECRET_KEY="yottaperf-super-secure-jwt-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (Local / Docker)
# For local dev host: port 5434 maps to container 5432
DATABASE_URL="postgresql://yotta_user:yotta_password@localhost:5434/yottaperf_db"
POSTGRES_USER=yotta_user
POSTGRES_PASSWORD=yotta_password
POSTGRES_DB=yottaperf_db
POSTGRES_PORT=5434

# Deterministic Generator Settings
DEFAULT_SEED=20261022
REFERENCE_DATE=2026-06-30

# Frontend Settings
NEXT_PUBLIC_API_URL="http://localhost:8001/api"
